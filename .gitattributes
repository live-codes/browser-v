* text=auto

# The V compiler and its standard library, built by the pipeline and committed so the package works
# offline (shipped gzipped). They are binary; do not let git try to diff or normalise them.
*.wasm binary
*.tar binary
*.gz binary

# Not project source: the Clang toolchain is copied out of an npm package, the V compiler artifacts are
# build output, and the IIFE bundle is generated by `npm run build:package`.
assets/clang/** linguist-vendored
packages/v-wasm/assets/** linguist-vendored
packages/v-wasm/dist/** linguist-generated
