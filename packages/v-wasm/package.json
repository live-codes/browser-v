{
  "name": "@live-codes/v-wasm",
  "version": "0.1.0",
  "description": "Run V (vlang) in the browser, on the V compiler compiled to WebAssembly",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/live-codes/browser-v.git",
    "directory": "packages/v-wasm"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "node": "./src/index.node.js",
      "browser": "./src/index.js",
      "default": "./src/index.js"
    },
    "./iife": "./dist/v-wasm.global.js"
  },
  "bin": {
    "v-wasm-copy-assets": "./bin/copy-assets.mjs"
  },
  "files": [
    "src",
    "bin",
    "scripts",
    "dist",
    "docs",
    "assets",
    "THIRD-PARTY-NOTICES.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:iife": "node scripts/build-iife.mjs",
    "test": "node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "@live-codes/clang-wasm": "^0.3.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "keywords": [
    "v",
    "vlang",
    "wasm",
    "webassembly",
    "compiler",
    "playground"
  ]
}
